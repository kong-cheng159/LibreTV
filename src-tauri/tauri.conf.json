{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LibreTV",
  "version": "2.23.4",
  "identifier": "com.libretv.desktop",
  "build": {
    "beforeDevCommand": "node scripts/desktop-dev-server.mjs",
    "devUrl": "http://127.0.0.1:18080",
    "beforeBuildCommand": "node scripts/prepare-sidecar.mjs",
    "frontendDist": "resources/splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/standalone/": "standalone/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "template": "windows/nsis/installer.nsi",
        "customLanguageFiles": {
          "SimpChinese": "windows/nsis/SimpChinese.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0M0RDNjhEMDhCMzUxRUIKUldUclViTUlqY1k5TkRDUkYwVlBDVzhaOTVDemFXN3EzYmJQZ0JWK0lyNUpzemp4dkZmanBRUG8K",
      "endpoints": [
        "https://github.com/kong-cheng159/LibreTV/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
