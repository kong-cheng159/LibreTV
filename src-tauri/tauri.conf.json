{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LibreTV",
  "version": "2.23.2",
  "identifier": "com.libretv.desktop",
  "build": {
    "beforeDevCommand": "node scripts/desktop-dev-server.mjs",
    "devUrl": "http://127.0.0.1:18080",
    "beforeBuildCommand": "node scripts/prepare-sidecar.mjs",
    "frontendDist": "resources/splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/standalone/": "standalone/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
