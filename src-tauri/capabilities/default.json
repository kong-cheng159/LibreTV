{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LibreTV 桌面窗口（含本机 sidecar 页面的 IPC）",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:47321/*",
      "http://127.0.0.1:18080/*",
      "http://localhost:47321/*",
      "http://localhost:18080/*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "updater:default",
    "process:default",
    "allow-save-text-file",
    "allow-desktop-download-write",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/node",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
